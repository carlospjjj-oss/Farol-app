<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/w_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚦 Farol"
        android:textColor="#1C1300"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_earn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-black"
        android:text="R$ 0,00"
        android:textColor="#1C1300"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/w_goal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ganhos de hoje"
        android:textColor="#B31C1300"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_shift"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="▶ Toque para iniciar o turno"
        android:textColor="#1C1300"
        android:textSize="12sp" />
</LinearLayout>
