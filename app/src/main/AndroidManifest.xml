<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Para vibrar quando chega oferta verde (opcional) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Só para o envio de logs (opcional, desligado por padrão) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notificação do turno e resumo da semana -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- GPS do turno (opcional, desligado por padrão). Só "durante o uso": roda como serviço em primeiro plano -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Atalho "Bateria sem restrição" do guia de instalação -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Para enxergar os apps de corrida ao listar pacotes (Android 11+) -->
    <queries>
        <package android:name="com.ubercab.driver" />
        <package android:name="com.app99.driver" />
        <package android:name="sinet.startup.inDriver" />
        <package android:name="br.com.ifood.driver.app" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".ui.DashboardActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"
            android:label="Guia de instalação" />

        <service
            android:name=".service.GpsService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".service.PauseReceiver"
            android:exported="false" />

        <receiver
            android:name=".ui.FarolWidget"
            android:exported="true"
            android:label="Farol">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <activity
            android:name=".ui.CostsActivity"
            android:exported="false"
            android:label="Custos do mês"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false"
            android:label="Histórico de ofertas" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="Configurações"
            android:windowSoftInputMode="adjustResize" />

        <!-- O coração do app: lê a tela dos apps de corrida e desenha o cartão. -->
        <service
            android:name=".service.OfferReaderService"
            android:exported="false"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- Botão liga/desliga nas Configurações rápidas -->
        <service
            android:name=".service.FarolTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="Farol"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
